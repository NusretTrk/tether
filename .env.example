# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit it.
# See docs/SETUP.md for how to get a bot token and chat ID.

# Required: token from @BotFather
BOT_TOKEN=

# Required: your numeric Telegram user ID (from @userinfobot).
# Only this chat ID is allowed to control the bot.
CHAT_ID=

# Optional: path to the Claude Code projects directory used for transcript
# tailing. Leave unset to use the default (~/.claude/projects on this OS).
# CLAUDE_PROJECTS_DIR=

# Optional, for future voice features (Phase 6, not yet implemented).
# ELEVENLABS_API_KEY=

# Optional second factor on top of CHAT_ID. CHAT_ID alone protects against
# a stranger who finds the bot, but does nothing if your own Telegram
# account gets compromised - whoever controls it is, as far as Telegram is
# concerned, genuinely you. Set this to require /unlock <password> before
# the bot does anything else (/lock to re-lock). Not required, but
# recommended if you want a second factor beyond your Telegram login.
# BOT_PASSWORD=

# Optional, only needed if you turn on the Telegram Mini App
# (mini_app_enabled in config.yaml). Your ngrok authtoken, from
# https://dashboard.ngrok.com/get-started/your-authtoken - handed to the
# ngrok process through its own environment, never written to any file
# tether controls and never logged. See SETUP.md for the one-time setup
# (free account, claim a free static domain, install ngrok).
# NGROK_AUTHTOKEN=
